# Required in production for persistent rooms. Use the PostgreSQL provider's
# external connection string when the app is hosted separately from the database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Public URL of the deployed frontend. Comma-separated origins are not supported;
# use the single production URL here.
CLIENT_URL=https://your-frontend.example.com

# Render and most hosts set PORT automatically.
PORT=3000

