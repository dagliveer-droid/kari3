# Required in production for persistent rooms.
# Neon: copy the direct (non-pooled) connection string from the Neon dashboard
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Public URL of the deployed frontend. Comma-separated origins are not supported;
# use the single production URL here.
CLIENT_URL=https://your-frontend.example.com

# Render and most hosts set PORT automatically.
PORT=3000

